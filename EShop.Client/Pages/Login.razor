@page "/login"

<div class="container mt-5" style="max-width: 420px;">
    <div class="card p-4 shadow-sm">
        <h3 class="text-center mb-3">Prisijungimas</h3>
        
        <div class="mb-3">
            <label class="form-label">El. paštas:</label>
            <input type="email" class="form-control" placeholder="vardas@pastas.lt" />
        </div>
        <div class="mb-3">
            <label class="form-label">Slaptažodis:</label>
            <input type="password" class="form-control" placeholder="••••••••" />
        </div>
        <button class="btn btn-primary w-100">Prisijungti</button>

        <div class="text-center mt-3">
            <small class="text-muted">Neturite paskyros? <a href="#">Registruotis</a></small>
        </div>
    </div>
</div>