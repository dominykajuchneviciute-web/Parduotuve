@page "/my-items"
@inject HttpClient Http

<div class="container mt-4">
    <h3>Mano siūlomi daiktai mainams</h3>

    <div class="row mt-4">
        <div class="col-md-5 mb-4">
            <div class="card p-3 shadow-sm">
                <h5>+ Siūlyti naują daiktą</h5>
                <hr />
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="alert alert-info py-2">@statusMessage</div>
                }
                <div class="mb-2">
                    <label class="form-label">Daikto pavadinimas:</label>
                    <input type="text" class="form-control" @bind="newItemTitle" placeholder="Pvz. Žieminė striukė" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Kategorija:</label>
                    <select class="form-select" @bind="newItemCategory">
                        <option value="Elektronika">Elektronika</option>
                        <option value="Drabužiai">Drabužiai</option>
                        <option value="Transportas">Transportas</option>
                        <option value="Knygos">Knygos</option>
                        <option value="Buitis">Buitis</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label">Mainų būdas:</label>
                    <select class="form-select" @bind="newItemExchangeType">
                        <option value="Gyvai">Gyvai</option>
                        <option value="Siuntimu">Siuntimu</option>
                        <option value="Gyvai arba siuntimu">Gyvai arba siuntimu</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label">Į ką norite išsimainyti?</label>
                    <input type="text" class="form-control" @bind="newItemLookingFor" placeholder="Pvz. Ieškau batų arba kuprinės" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Aprašymas:</label>
                    <textarea class="form-control" rows="2" @bind="newItemDescription" placeholder="Daikto būklė, dydis ir kiti duomenys..."></textarea>
                </div>
                <button class="btn btn-success w-100 mt-3" @onclick="CreateItem">Paskelbti mainams</button>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card p-3 shadow-sm">
                <h5>Mano pasiūlymai serveryje (@serverItems.Count)</h5>
                <hr />
                @if (isLoading)
                {
                    <p class="text-muted">Kraunama iš serverio...</p>
                }
                else if (!serverItems.Any())
                {
                    <p class="text-muted">Šiuo metu nesate įkėlę jokių daiktų.</p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var item in serverItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@item.Title</strong>
                                    <div class="text-muted small">Būdas: @item.ExchangeType | Keičiama į: @item.LookingFor</div>
                                </div>
                                <div>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteItem(item.Id)">Ištrinti</button>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<ItemDto> serverItems = new();
    private bool isLoading = true;
    private string statusMessage = "";

    private string newItemTitle = "";
    private string newItemDescription = "";
    private string newItemCategory = "Elektronika";
    private string newItemExchangeType = "Gyvai";
    private string newItemLookingFor = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
    }

    private async Task LoadItems()
    {
        isLoading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<List<ItemDto>>("http://localhost:5000/api/items");
            serverItems = response ?? new List<ItemDto>();
        }
        catch
        {
            statusMessage = "Nepavyko prisijungti prie API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateItem()
    {
        if (string.IsNullOrWhiteSpace(newItemTitle) || string.IsNullOrWhiteSpace(newItemLookingFor))
        {
            statusMessage = "Nurodykite pavadinimą ir į ką norite išsimainyti!";
            return;
        }

        var payload = new 
        { 
            Title = newItemTitle, 
            Description = newItemDescription, 
            Category = newItemCategory,
            ExchangeType = newItemExchangeType,
            LookingFor = newItemLookingFor
        };

        var response = await Http.PostAsJsonAsync("http://localhost:5000/api/items", payload);

        if (response.IsSuccessStatusCode)
        {
            statusMessage = "Mainų skelbimas sėkmingai paskelbtas!";
            newItemTitle = "";
            newItemDescription = "";
            newItemLookingFor = "";
            await LoadItems();
        }
    }

    private async Task DeleteItem(int id)
    {
        var response = await Http.DeleteAsync($"http://localhost:5000/api/items/{id}");
        if (response.IsSuccessStatusCode)
        {
            statusMessage = "Skelbimas pašalintas!";
            await LoadItems();
        }
    }

    public record ItemDto(int Id, string Title, string Description, string Category, string ExchangeType, string LookingFor);
}