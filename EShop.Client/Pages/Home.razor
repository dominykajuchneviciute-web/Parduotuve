    </div>
</div>

@code {
    private string apiStatus = "Tikrinama...";

    protected override async Task OnInitializedAsync()
    {
        await CheckApiStatus();
    }

    private async Task CheckApiStatus()
    {
        apiStatus = "Jungiamasi prie API...";
        try
        {
            var response = await Http.GetFromJsonAsync<StatusResponse>("http://localhost:5000/api/status");
            apiStatus = response?.Message ?? "Atsakymas gautas, bet tuščias.";
        }
        catch
        {
            apiStatus = "Nepavyko prisijungti prie backendo (patikrinkite ar paleistas EShop.Api).";
        }
    }

    public record StatusResponse(string Message);
}