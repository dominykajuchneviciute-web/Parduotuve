    <h3 class="mt-5 mb-3">Naujausi mainų pasiūlymai</h3>
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm border-start border-4">
                <div class="card-body">
                    <h5>Miesto dviratis</h5>
                    <p class="text-muted small mb-2">Maino būdas: <span class="badge bg-info text-dark">Gyvai</span></p>
                    <p class="mb-3"><strong>Ieško mainams:</strong> Paspirtuko arba laikrodžio</p>
                    <a href="item/1" class="btn btn-sm btn-outline-primary">Peržiūrėti daiktą</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm border-start border-4">
                <div class="card-body">
                    <h5>Dell 24" monitorius</h5>
                    <p class="text-muted small mb-2">Maino būdas: <span class="badge bg-secondary">Siuntimu</span></p>
                    <p class="mb-3"><strong>Ieško mainams:</strong> Grafinės planšetės</p>
                    <a href="item/2" class="btn btn-sm btn-outline-primary">Peržiūrėti daiktą</a>
                </div>
            </div>
