        <div class="d-flex justify-content-center gap-3 mt-3">
            <a href="items" class="btn btn-primary btn-lg">Naršyti daiktus</a>
            <a href="my-items" class="btn btn-outline-secondary btn-lg">Pasiūlyti mainams</a>
        </div>
    </div>

