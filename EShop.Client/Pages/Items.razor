@page "/items"
@inject HttpClient Http

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="card p-3 shadow-sm mb-4">
                <h5>Filtrai</h5>
                <hr />
                <div class="mb-3">
                    <label class="form-label">Paieška:</label>
                    <input type="text" class="form-control" placeholder="Ieškoti pagal pavadinimą..." @bind="searchQuery" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Kategorija:</label>
                    <select class="form-select" @bind="selectedCategory">
                        <option value="">Visos kategorijos</option>
                        <option value="Transportas">Transportas</option>
                        <option value="Elektronika">Elektronika</option>
                        <option value="Knygos">Knygos</option>
                        <option value="Buitis">Buitis</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Mainų būdas:</label>
                    <select class="form-select" @bind="selectedExchangeType">
                        <option value="">Visi būdai</option>
                        <option value="Gyvai">Gyvai</option>
                        <option value="Siuntimu">Siuntimu</option>
                    </select>
                </div>
                <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">Išvalyti filtrus</button>
            </div>
        </div>

        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Visi siūlomi daiktai</h3>
                <a href="my-items" class="btn btn-success">+ Siūlyti daiktą</a>
            </div>

            @if (isLoading)
            {
                <div class="alert alert-info">Kraunami daiktai iš serverio...</div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            else if (!FilteredItems.Any())
            {
                <div class="alert alert-warning">Pagal nurodytus filtrus daiktų nerasta.</div>
            }
            else
            {
                <div class="row">
                    @foreach (var item in FilteredItems)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div style="height: 120px; background-color: #f8f9fa;" class="d-flex align-items-center justify-content-center text-muted border-bottom">
                                    @item.Category
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@item.Title</h5>
                                    <div class="mb-2">
                                        <span class="badge bg-secondary me-1">@item.Category</span>
                                        <span class="badge bg-info text-dark">@item.ExchangeType</span>
                                    </div>
                                    <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                                    <div class="bg-light p-2 rounded mb-3 small">
                                        <strong>Keičia į:</strong> @item.LookingFor
                                    </div>
                                    <a href="item/@item.Id" class="btn btn-outline-primary btn-sm w-100">Peržiūrėti pasiūlymą</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<ItemDto> allItems = new();
    private bool isLoading = true;
    private string errorMessage = "";
    private string searchQuery = "";
    private string selectedCategory = "";
    private string selectedExchangeType = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<ItemDto>>("http://localhost:5000/api/items");
            allItems = response ?? new List<ItemDto>();
        }
        catch (Exception ex)
        {
            errorMessage = "Nepavyko pasiekti API serverio: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<ItemDto> FilteredItems => allItems
        .Where(i => string.IsNullOrWhiteSpace(searchQuery) || i.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(i => string.IsNullOrWhiteSpace(selectedCategory) || i.Category == selectedCategory)
        .Where(i => string.IsNullOrWhiteSpace(selectedExchangeType) || i.ExchangeType.Contains(selectedExchangeType, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void ResetFilters()
    {
        searchQuery = "";
        selectedCategory = "";
        selectedExchangeType = "";
    }

    public record ItemDto(int Id, string Title, string Description, string Category, string ExchangeType, string LookingFor);
}